[Unit]
Description=Sign Language Translator Hardware Service
After=network-online.target sound.target graphical.target
Wants=network-online.target

[Service]
Type=simple

# User running the Raspberry Pi system
User=hamada

# Folder containing the translator script
WorkingDirectory=/home/hamada/sign-translator

# Wait 20 seconds after boot to ensure camera, network, and audio are ready
ExecStartPre=/bin/sleep 20

# Start the translator script
ExecStart=/usr/bin/python3 -u /home/hamada/sign-translator/translator.py

# Do not restart automatically
Restart=no

# Required environment variables for audio and GUI access
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000

# Log output to systemd journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
