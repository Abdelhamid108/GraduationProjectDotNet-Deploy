# --- API Keys ---
CORRECT_SENTENCE_KEY=your-correct-sentence-api-key
GENERATE_AUDIO_KEY=your-generate-audio-api-key
GENERATE_TEXT_FROM_AUDIO_KEY=your-generate-text-from-audio-api-key

# --- Database ---
DEFAULT_CONNECTION=Your-Database-Connection-String

# --- JWT Settings ---
SECRET_KEY=your-jwt-secret-key
ISSUER=your-app-name-or-issuer

# --- Google Auth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_SSL=false
MAIL_NAME=Your App Name
MAIL_EMAIL_ID=your-email@example.com
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password-or-app-password

# --- Ports ---
PORT=5001
