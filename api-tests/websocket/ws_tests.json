{
    "version": "1.0",
    "description": "WebSocket/SignalR Test Scenarios for SignHub",
    "signalr_config": {
        "hub_path": "/signHub",
        "negotiate_path": "/signHub/negotiate",
        "protocol": "json",
        "version": "1"
    },
    "tests": [
        {
            "id": "ws_signalr_negotiate",
            "name": "SignalR Negotiation",
            "type": "http",
            "description": "Negotiate SignalR connection parameters",
            "method": "POST",
            "path": "/signHub/negotiate",
            "query_params": {
                "negotiateVersion": "1"
            },
            "expected_status": 200,
            "expected_fields": [
                "connectionToken",
                "availableTransports"
            ]
        },
        {
            "id": "ws_connect",
            "name": "WebSocket Connection",
            "type": "websocket",
            "description": "Establish WebSocket connection to SignalR hub",
            "action": "connect",
            "timeout_ms": 10000,
            "expected": "connection_established"
        },
        {
            "id": "ws_handshake",
            "name": "SignalR Handshake",
            "type": "websocket",
            "description": "Send SignalR handshake with protocol version",
            "action": "send",
            "message": "{\"protocol\":\"json\",\"version\":1}\u001e",
            "expected_response": "{}",
            "timeout_ms": 5000
        },
        {
            "id": "ws_process_frame_valid",
            "name": "ProcessFrame with Valid Image",
            "type": "websocket",
            "description": "Send a valid sign language frame for processing",
            "action": "invoke",
            "method": "ProcessFrame",
            "arguments": {
                "imageData": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
            },
            "expected_event": "ReceiveTranslation",
            "timeout_ms": 10000
        },
        {
            "id": "ws_process_frame_empty",
            "name": "ProcessFrame with Empty Data",
            "type": "websocket",
            "description": "Send empty image data to test error handling",
            "action": "invoke",
            "method": "ProcessFrame",
            "arguments": {
                "imageData": ""
            },
            "expected_error": true,
            "timeout_ms": 5000
        },
        {
            "id": "ws_process_frame_invalid",
            "name": "ProcessFrame with Invalid Base64",
            "type": "websocket",
            "description": "Send invalid base64 to test error handling",
            "action": "invoke",
            "method": "ProcessFrame",
            "arguments": {
                "imageData": "not-valid-base64!!!"
            },
            "expected_error": true,
            "timeout_ms": 5000
        },
        {
            "id": "ws_invalid_method",
            "name": "Invoke Invalid Method",
            "type": "websocket",
            "description": "Attempt to invoke a non-existent hub method",
            "action": "invoke",
            "method": "NonExistentMethod",
            "arguments": {},
            "expected_error": true,
            "timeout_ms": 5000
        },
        {
            "id": "ws_malformed_json",
            "name": "Send Malformed JSON",
            "type": "websocket",
            "description": "Send malformed JSON to test error handling",
            "action": "send",
            "message": "{invalid json here",
            "expected_error": true,
            "timeout_ms": 3000
        },
        {
            "id": "ws_ping_pong",
            "name": "SignalR Ping",
            "type": "websocket",
            "description": "Send SignalR ping message",
            "action": "send",
            "message": "{\"type\":6}\u001e",
            "expected_response": "none",
            "timeout_ms": 2000
        },
        {
            "id": "ws_disconnect",
            "name": "Graceful Disconnect",
            "type": "websocket",
            "description": "Close WebSocket connection gracefully",
            "action": "disconnect",
            "expected": "connection_closed"
        }
    ],
    "test_order": [
        "ws_signalr_negotiate",
        "ws_connect",
        "ws_handshake",
        "ws_ping_pong",
        "ws_process_frame_valid",
        "ws_process_frame_empty",
        "ws_invalid_method",
        "ws_disconnect"
    ],
    "sample_images": {
        "tiny_valid_png": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==",
        "description": "1x1 transparent PNG for basic connectivity testing"
    }
}